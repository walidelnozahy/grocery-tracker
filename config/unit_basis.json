{
  "_comment": "How prices are compared. 'categories' maps each product category to a comparison basis. 'bases' says what one basis unit is. 'units' converts every size unit into its dimension's base unit (volume -> fl_oz, mass -> oz, count -> count, sheets -> sheets).",
  "categories": {
    "milk": "fl_oz",
    "plant_milk": "fl_oz",
    "juice": "fl_oz",
    "soda": "fl_oz",
    "water": "fl_oz",
    "cooking_oil": "fl_oz",
    "condiments": "oz",
    "yogurt": "oz",
    "cheese": "oz",
    "butter": "oz",
    "eggs": "count",
    "bread": "oz",
    "tortillas": "count",
    "cereal": "oz",
    "oats": "oz",
    "rice": "lb",
    "pasta": "oz",
    "pasta_sauce": "oz",
    "instant_noodles": "oz",
    "flour": "lb",
    "sugar": "lb",
    "beans": "oz",
    "canned_goods": "oz",
    "peanut_butter": "oz",
    "snacks": "oz",
    "coffee": "oz",
    "tea": "count",
    "produce_fruit": "lb",
    "produce_vegetables": "lb",
    "meat": "lb",
    "poultry": "lb",
    "seafood": "lb",
    "deli": "oz",
    "frozen_meals": "oz",
    "frozen_vegetables": "oz",
    "toilet_paper": "100_sheets",
    "paper_towels": "100_sheets",
    "dish_soap": "fl_oz",
    "laundry_detergent": "fl_oz",
    "tvs": "count",
    "electronics": "count"
  },
  "bases": {
    "fl_oz":      { "dimension": "volume", "base_amount": 1,   "label": "fl oz" },
    "oz":         { "dimension": "mass",   "base_amount": 1,   "label": "oz" },
    "lb":         { "dimension": "mass",   "base_amount": 16,  "label": "lb" },
    "count":      { "dimension": "count",  "base_amount": 1,   "label": "item" },
    "100_sheets": { "dimension": "sheets", "base_amount": 100, "label": "100 sheets" }
  },
  "units": {
    "gal":    { "dimension": "volume", "to_base": 128 },
    "qt":     { "dimension": "volume", "to_base": 32 },
    "pt":     { "dimension": "volume", "to_base": 16 },
    "L":      { "dimension": "volume", "to_base": 33.814 },
    "ml":     { "dimension": "volume", "to_base": 0.033814 },
    "fl_oz":  { "dimension": "volume", "to_base": 1 },
    "lb":     { "dimension": "mass",   "to_base": 16 },
    "oz":     { "dimension": "mass",   "to_base": 1 },
    "kg":     { "dimension": "mass",   "to_base": 35.27396 },
    "g":      { "dimension": "mass",   "to_base": 0.03527396 },
    "count":  { "dimension": "count",  "to_base": 1 },
    "sheets": { "dimension": "sheets", "to_base": 1 }
  }
}
